{
  "name": "NSD Lite 2 · Errors & Reminders",
  "nodes": [
    {
      "parameters": {},
      "id": "n1",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// One readable line per failure, for the sheet and for the staff group.\nconst e = $json.execution || {};\nconst wf = $json.workflow || {};\nconst message = (e.error?.message || $json.trigger?.error?.message || 'Unknown error').slice(0, 500);\nreturn [{ json: {\n  time: $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd HH:mm'),\n  workflow: wf.name || '',\n  node: e.lastNodeExecuted || '',\n  message,\n  execution_url: e.url || '',\n  text: `⚠️ ${wf.name || 'Workflow'} failed at \"${e.lastNodeExecuted || '?'}\"\\n${message}\\n${e.url || ''}`,\n} }];"
      },
      "id": "n2",
      "name": "Describe Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_ID",
          "mode": "id",
          "cachedResultName": "NSD Lite Data"
        },
        "sheetName": {
          "__rl": true,
          "value": 104,
          "mode": "id",
          "cachedResultName": "Errors"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "time": "={{ $json.time }}",
            "workflow": "={{ $json.workflow }}",
            "node": "={{ $json.node }}",
            "message": "={{ $json.message }}",
            "execution_url": "={{ $json.execution_url }}"
          },
          "matchingColumns": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true,
          "schema": [
            {
              "id": "time",
              "displayName": "time",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true,
              "removed": false
            },
            {
              "id": "workflow",
              "displayName": "workflow",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true,
              "removed": false
            },
            {
              "id": "node",
              "displayName": "node",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true,
