      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "n5",
      "name": "Every 30 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        256
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "YOUR_ID",
          "mode": "id",
          "cachedResultName": "NSD Lite Data"
        },
        "sheetName": {
          "__rl": true,
          "value": 102,
          "mode": "id",
          "cachedResultName": "Tickets"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "status",
              "lookupValue": "open"
            }
          ]
        },
        "options": {}
      },
      "id": "n6",
      "name": "Read Open Tickets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        224,
        256
      ],
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Tickets still \"open\" 30+ minutes after creation. One message for all of them.\nconst cutoff = Date.now() - 30 * 60 * 1000;\nconst old = $input.all().map(i => i.json)\n  .filter(t => t.ticket_id && t.status === 'open')\n  .filter(t => new Date(String(t.created_at).replace(' ', 'T') + ':00+02:00').getTime() < cutoff);\nif (!old.length) return [];\nconst lines = old.map(t => `• ${t.ticket_id} · ${t.priority} · ${t.customer_name || t.customer_id} (${t.channel}) · ${t.summary}`);\nreturn [{ json: { count: old.length,\n  text: `⏰ ${old.length} ticket(s) waiting 30+ minutes:\\n${lines.join('\\n')}\\n\\nReply with: /reply <ticket_id> your message` } }];"
      },
      "id": "n7",
      "name": "Find Waiting Tickets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        256
      ]
    },
    {
      "parameters": {
        "chatId": "YOUR_CHAT_ID",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "n8",
      "name": "Remind Staff",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        672,
        256
      ]
    }
  ],
